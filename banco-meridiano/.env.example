# .env.example --- copia a .env y rellena. NUNCA se commitea el .env.
# Este fichero va vacío a propósito: en este repo no hay ni un secreto.
#
# El código no conoce proveedores de modelos, solo conoce tu gateway (0.4).
# Cambiar de un modelo a otro es configuración de LiteLLM, no un despliegue.

# El proxy LiteLLM del 0.5 y la clave VIRTUAL que emitiste allí.
OPENAI_API_BASE=
OPENAI_API_KEY=

# Postgres: checkpointer (5.2), Store (6.2), corpus (7.6) y cola (11.2).
DATABASE_URL=
# La misma base con driver explícito, que es lo que PGEngine exige (7.4):
# postgresql+psycopg://usuario:clave@host:5432/banco_meridiano
DATABASE_URL_SQLALCHEMY=

# Observabilidad (15.1). Sin trace_id y versión no hay auditoría.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=banco-meridiano

# --- solo para el canal de Slack (12.6) ---
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# --- solo para el cliente MCP hacia el core (10.2) ---
MCP_CORE_URL=

# --- solo para el teléfono y el kiosco (13.4, 14.2) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
TAVUS_API_KEY=
TAVUS_FACE_ID=
