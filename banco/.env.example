# .env.example --- GENERADO desde el bloque `.env` del 0.4 de libro.md
# por tools/generar_env/generar_env.py. NO editar a mano: si falta una
# variable se anade en el libro y se vuelve a generar.
#
# Copia a .env y rellena. El .env no entra en el repo jamas, y en este
# fichero no hay ni un secreto: los valores que quedan puestos son los
# que el libro da como valor y no como marcador.
#
# El codigo no conoce proveedores de modelos, solo conoce tu gateway
# (0.4). Cambiar de modelo es configuracion de LiteLLM, no un
# despliegue.

OPENAI_API_BASE=                         # proxy LiteLLM
OPENAI_API_KEY=
DATABASE_URL=
# la misma base con driver explícito, para PGEngine (M7):
DATABASE_URL_SQLALCHEMY=
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=banco
# Hasta aquí el mínimo. Debajo, las diecinueve que estrenan apartados
# posteriores, cada una con el suyo al lado. Van en este mismo
# fichero, y están aquí para que el `os.environ` que las lee no
# sea el primer sitio donde te enteras de que existen.
SLACK_SIGNING_SECRET=                    # el webhook del 12.6
SLACK_BOT_TOKEN=                         # el mismo, del 12.6
MCP_CORE_URL=http://localhost:8081/mcp   # el mcp_core.py del 10.2
LIVEKIT_URL=                             # el agente_voz.py del 13.4
LIVEKIT_API_KEY=                         # el mismo, del 13.4
LIVEKIT_API_SECRET=                      # el mismo, del 13.4
DEEPGRAM_API_KEY=                        # su STT, del 13.4
CARTESIA_API_KEY=                        # su TTS, del 13.4
TAVUS_API_KEY=                           # la cara.py del 14.2
TAVUS_FACE_ID=                           # la misma, del 14.2
MODEL_ROUTING=config/model_routing.yaml  # el router del 19.6
POLITICA_BUNDLE=config/politica.yaml     # el motor del 26.5
LAKE_URL=                                # las trazas frías del 28.5
EQUIPO=/srv/banco/equipo.yaml            # el equipo.py del 30.5
ENTORNO=dev                              # dev, pre o prod: el 32.2
BUNDLES=/srv/banco/pkg                   # los paquetes del 32.3
HITL_CLAVE=                              # firma los recibos del 35.6
DATABASE_URL_APP=                        # el rol NOBYPASSRLS del 16.6
TENANT=banco                             # el inquilino, para el 34.7
